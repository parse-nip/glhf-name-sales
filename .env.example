# OpenSea API key (server-side only) — get one at https://opensea.io/settings/developer
OPENSEA_API_KEY=

# WalletConnect project ID — get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deploy NameMarketplace.sol to Abstract and set the address
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
